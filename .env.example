# ==============================================================================
# Waskita - Environment Variables Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waskita_db

# Cache & Queue Configuration (Redis)
REDIS_URL=redis://localhost:6379/0

# Authentication (NextAuth)
NEXTAUTH_SECRET=your-nextauth-secret-key-placeholder
NEXTAUTH_URL=http://localhost:3000

# Backend API Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
