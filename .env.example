# ==============================================================================
# Waskita - Environment Variables Configuration Template
# Salin file ini menjadi `.env` (atau `.env.local` untuk Next.js):
#   Windows (PowerShell): copy .env.example .env
#   Linux/macOS:          cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Opsi A (Rekomendasi Kontributor / Plug-and-Play tanpa Docker): Gunakan SQLite
DATABASE_URL=sqlite:///./waskita_dev.db

# Opsi B (Production / Docker Compose): Gunakan PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waskita_db

# ------------------------------------------------------------------------------
# 2. Cache & Queue Configuration (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Authentication (NextAuth & JWT)
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=waskita-dev-secret-token-key-2026
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Backend API Configuration (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Frontend Next.js Public API URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
